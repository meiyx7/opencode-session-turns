{
  "name": "opencode-timeline-gui",
  "version": "0.2.7",
  "description": "OpenCode Desktop 插件：在会话右缘列出每一轮用户提问，点击即可跳转到对应消息。A right-edge rail of user turns; click one to jump to that message. (formerly opencode-session-turns)",
  "type": "module",
  "license": "MIT",
  "author": "meiyx7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meiyx7/opencode-timeline-gui.git"
  },
  "homepage": "https://github.com/meiyx7/opencode-timeline-gui#readme",
  "bugs": {
    "url": "https://github.com/meiyx7/opencode-timeline-gui/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "timeline",
    "gui",
    "session",
    "turns",
    "navigation",
    "jump",
    "message"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --conditions=browser --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "node scripts/ensure-ci-publish.mjs && npm run build"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "solid-js": "^1.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
